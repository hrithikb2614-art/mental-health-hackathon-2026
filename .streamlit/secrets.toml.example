# Copy this file to .streamlit/secrets.toml (gitignored) and fill in a real
# value to enable the Find a Hospital tab's map. Without it, that tab shows a
# setup message and the rest of the app works normally.

# From Google Cloud Console: create a project, enable the "Maps Embed API",
# create an API key, and restrict it (HTTP referrers) to the domain(s) you
# deploy this app to. The Maps Embed API itself is free with no query limit,
# but the Cloud project still needs billing enabled to issue API keys.
GOOGLE_MAPS_API_KEY = "xxxx"
