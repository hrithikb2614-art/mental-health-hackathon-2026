# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values
# to enable the AI Assistant tab. Without these, that tab shows a setup message
# and the rest of the app works normally.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "YOUR-SUPABASE-SERVICE-ROLE-OR-ANON-KEY"
OPENAI_API_KEY = "sk-..."

# Required to see the "Load a document" uploader in the AI Assistant tab.
# Anyone who knows this password can add documents to the shared knowledge base
# that every visitor's AI Assistant answers draw from, so keep it private.
ADMIN_PASSWORD = "choose-a-password"
